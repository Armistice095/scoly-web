# Copier ce fichier en .env et adapter (le fichier .env n'est jamais commité).
#
# URL de l'API backend (scoly-api), sans « / » final.
# ATTENTION : variable lue à la CONSTRUCTION (build) du site ($env/static/public).
# En production, la définir dans l'hébergeur AVANT le build, en https://… ;
# la modifier ensuite oblige à reconstruire/redéployer.
PUBLIC_API_URL="http://localhost:3000"
